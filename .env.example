# SymbioLink AI Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration -- MySQL for both development and production, in two
# separate databases so they can never collide. Note the "mysql+pymysql://"
# prefix (not plain "mysql://"): that tells SQLAlchemy to use the PyMySQL
# driver from requirements.txt. Create both databases first in the MySQL
# shell (Flask-SQLAlchemy creates the tables inside them on first run, but
# not the databases themselves):
#   CREATE DATABASE symbiolink_dev;
#   CREATE DATABASE symbiolink;
# Fill in your real MySQL username/password below (defaults assume the
# standard "root" user with no/placeholder password many local installs use):
DEV_DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/symbiolink_dev

# For production (FLASK_ENV=production), running your own MySQL:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/symbiolink
#
# Deploying to Render instead: don't set DATABASE_URL yourself at all --
# Render injects it automatically once you attach its managed Postgres
# database (see render.yaml), already in the "postgresql://..." form
# config.py expects. Nothing here needs to change for that switch; it's
# handled entirely by which host sets this variable and to what.

# Twilio Configuration (for WhatsApp integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Razorpay Configuration (for payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps Configuration (for accurate distances)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---------------------------------------------------------------------------
# Email (SMTP) -- Gmail
# ---------------------------------------------------------------------------
# SMTP_PASSWORD is NOT your Gmail account password. Gmail rejects those over
# SMTP. You need a 16-character App Password:
#   1. Turn on 2-Step Verification on the account
#      (https://myaccount.google.com/security -- App Passwords does not exist
#      as an option until 2FA is on)
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create one named e.g. "SymbioLink", copy the 16 characters
#   4. Paste it below. Spaces in it are fine -- Google displays it grouped as
#      "abcd efgh ijkl mnop" and either form works.
# Keep port 587 (STARTTLS). Port 465 also works -- email_service.py picks
# implicit TLS automatically when the port is 465.
# Leaving these blank keeps the app in simulation mode: emails are printed to
# the console instead of sent, so login/listing/OTP features all still work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=sysmbiolink@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM_ADDRESS=sysmbiolink@gmail.com
SMTP_FROM_NAME=SymbioLink AI

# Optional: send email through Brevo's HTTPS API instead of SMTP (required on
# Render's free tier, which blocks SMTP). Free: 300 emails/day. Get a key at
# https://app.brevo.com/settings/keys/api and verify SMTP_FROM_ADDRESS as a
# sender under Senders & IP. When set, the SMTP_* login above is not used.
BREVO_API_KEY=


# Notification fan-out switches (both default to on).
# NOTIFY_ALL_ON_NEW_LISTING emails every registered user when a company posts
# a listing. Note a free Gmail account allows ~500 recipients/day, and one
# broadcast spends (number of registered users) of that budget -- set this to
# false if you hit the cap.
NOTIFY_ALL_ON_NEW_LISTING=true
NOTIFY_ON_LOGIN=true

# ---------------------------------------------------------------------------
# Two-factor (OTP) sign-in
# ---------------------------------------------------------------------------
# With OTP_ENABLED=true, a correct password is NOT enough to sign in: a
# 6-digit code is emailed and must be entered too. Codes expire in 10 minutes,
# work once, allow 5 wrong guesses, and can be resent once a minute (tune all
# of those in otp_service.py).
#
# The code path is an ALTERNATIVE to the password form, not a step in front
# of it: a password alone signs you in, and a code alone signs you in.
# Set OTP_ENABLED=false to hide the code option and require passwords.
OTP_ENABLED=true

# ---------------------------------------------------------------------------
# Cluster map (OpenStreetMap)
# ---------------------------------------------------------------------------
# Real-world anchor for the km grid the matching engine uses. Seeded demo
# units have grid coordinates only, so this is where they get drawn; units
# registered through the map picker store their own real coordinates and are
# unaffected. Default is Coimbatore, Tamil Nadu.
CLUSTER_ORIGIN_LAT=11.0168
CLUSTER_ORIGIN_LNG=76.9558

# Optional: MuRIL upgrade for Hinglish/Devanagari intake (see ml_multilingual.py).
# Off by default -- ml_text.py's TF-IDF matcher + Hinglish alias/keyword lists
# already handle common romanized Hindi-English phrasing with no setup. Only
# set this AND `pip install transformers torch` if you need to understand
# Devanagari script or phrasing the alias lists don't cover -- torch is a large
# (500MB-2GB+) dependency, so it's intentionally not installed by default.
# USE_MURIL=1

# ---------------------------------------------------------------------------
# Admin notifications
# ---------------------------------------------------------------------------
# Inbox that receives admin copies of order and dispute emails (the seeded
# admin account's address is a placeholder). Comma-separate several.
ADMIN_EMAIL=sysmbiolink@gmail.com

# ---------------------------------------------------------------------------
# AI assistant (Google Gemini, free tier)
# ---------------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey . Without it the chat still
# works in "basic mode" (rule-based answers from the same data).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
