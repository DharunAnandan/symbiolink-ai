# SymbioLink AI Environment Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production

# Database Configuration -- MySQL for both development and production, in two
# separate databases so they can never collide. Note the "mysql+pymysql://"
# prefix (not plain "mysql://"): that tells SQLAlchemy to use the PyMySQL
# driver from requirements.txt. Create both databases first in the MySQL
# shell (Flask-SQLAlchemy creates the tables inside them on first run, but
# not the databases themselves):
#   CREATE DATABASE symbiolink_dev;
#   CREATE DATABASE symbiolink;
# Fill in your real MySQL username/password below (defaults assume the
# standard "root" user with no/placeholder password many local installs use):
DEV_DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/symbiolink_dev

# For production (FLASK_ENV=production), running your own MySQL:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost/symbiolink
#
# Deploying to Render instead: don't set DATABASE_URL yourself at all --
# Render injects it automatically once you attach its managed Postgres
# database (see render.yaml), already in the "postgresql://..." form
# config.py expects. Nothing here needs to change for that switch; it's
# handled entirely by which host sets this variable and to what.

# Twilio Configuration (for WhatsApp integration)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Razorpay Configuration (for payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Maps Configuration (for accurate distances)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: MuRIL upgrade for Hinglish/Devanagari intake (see ml_multilingual.py).
# Off by default -- ml_text.py's TF-IDF matcher + Hinglish alias/keyword lists
# already handle common romanized Hindi-English phrasing with no setup. Only
# set this AND `pip install transformers torch` if you need to understand
# Devanagari script or phrasing the alias lists don't cover -- torch is a large
# (500MB-2GB+) dependency, so it's intentionally not installed by default.
# USE_MURIL=1